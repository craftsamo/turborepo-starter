{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "repo-kit": {
      "repository": "craftsamo/repo-kit",
      "description": "Use when changing or debugging what repo-kit provides here: the setup, release, label and /oc workflows, the shared agents and skills, and the commit size check. Its main can be ahead of the v1 this repository pins; node_modules/@craftsamo/repo-kit/package.json has the installed version.",
    },
  },
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    // Read / inspect (safe)
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "tail -f*", "effect": "ask" },
    { "action": "shell", "resource": "tail -F*", "effect": "ask" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "du *", "effect": "allow" },
    { "action": "shell", "resource": "df *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "jq *", "effect": "allow" },
    { "action": "shell", "resource": "pwd *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "whoami *", "effect": "allow" },
    { "action": "shell", "resource": "uname *", "effect": "allow" },
    { "action": "shell", "resource": "date *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "printf *", "effect": "allow" },
    { "action": "shell", "resource": "realpath *", "effect": "allow" },
    { "action": "shell", "resource": "dirname *", "effect": "allow" },
    { "action": "shell", "resource": "basename *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "uniq *", "effect": "allow" },
    { "action": "shell", "resource": "cut *", "effect": "allow" },
    { "action": "shell", "resource": "tr *", "effect": "allow" },
    { "action": "shell", "resource": "nl *", "effect": "allow" },
    { "action": "shell", "resource": "column *", "effect": "allow" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },
    { "action": "shell", "resource": "comm *", "effect": "allow" },
    { "action": "shell", "resource": "tree *", "effect": "allow" },
    { "action": "shell", "resource": "type *", "effect": "allow" },
    { "action": "shell", "resource": "command -v *", "effect": "allow" },
    { "action": "shell", "resource": "printenv *", "effect": "allow" },
    { "action": "shell", "resource": "base64 *", "effect": "allow" },
    { "action": "shell", "resource": "xxd *", "effect": "allow" },
    { "action": "shell", "resource": "shasum *", "effect": "allow" },
    { "action": "shell", "resource": "md5 *", "effect": "allow" },
    { "action": "shell", "resource": "mkdir *", "effect": "allow" },
    { "action": "shell", "resource": "touch *", "effect": "allow" },
    { "action": "shell", "resource": "tac *", "effect": "allow" },
    { "action": "shell", "resource": "rev *", "effect": "allow" },
    { "action": "shell", "resource": "paste *", "effect": "allow" },
    { "action": "shell", "resource": "join *", "effect": "allow" },
    { "action": "shell", "resource": "fold *", "effect": "allow" },
    { "action": "shell", "resource": "fmt *", "effect": "allow" },
    { "action": "shell", "resource": "expand *", "effect": "allow" },
    { "action": "shell", "resource": "unexpand *", "effect": "allow" },
    { "action": "shell", "resource": "seq *", "effect": "allow" },
    { "action": "shell", "resource": "expr *", "effect": "allow" },
    { "action": "shell", "resource": "cmp *", "effect": "allow" },
    { "action": "shell", "resource": "od *", "effect": "allow" },
    { "action": "shell", "resource": "hexdump *", "effect": "allow" },
    { "action": "shell", "resource": "strings *", "effect": "allow" },
    { "action": "shell", "resource": "egrep *", "effect": "allow" },
    { "action": "shell", "resource": "fgrep *", "effect": "allow" },
    { "action": "shell", "resource": "gron *", "effect": "allow" },
    { "action": "shell", "resource": "cksum *", "effect": "allow" },
    { "action": "shell", "resource": "sha1sum *", "effect": "allow" },
    { "action": "shell", "resource": "sha256sum *", "effect": "allow" },
    { "action": "shell", "resource": "sha512sum *", "effect": "allow" },
    // System info
    { "action": "shell", "resource": "id *", "effect": "allow" },
    { "action": "shell", "resource": "groups *", "effect": "allow" },
    { "action": "shell", "resource": "hostname *", "effect": "allow" },
    { "action": "shell", "resource": "uptime *", "effect": "allow" },
    { "action": "shell", "resource": "arch *", "effect": "allow" },
    { "action": "shell", "resource": "nproc *", "effect": "allow" },
    { "action": "shell", "resource": "sw_vers *", "effect": "allow" },
    { "action": "shell", "resource": "getconf *", "effect": "allow" },
    { "action": "shell", "resource": "locale *", "effect": "allow" },
    { "action": "shell", "resource": "cal *", "effect": "allow" },
    { "action": "shell", "resource": "ps *", "effect": "allow" },
    { "action": "shell", "resource": "pgrep *", "effect": "allow" },
    { "action": "shell", "resource": "lsof *", "effect": "allow" },
    // Docs
    { "action": "shell", "resource": "man *", "effect": "allow" },
    { "action": "shell", "resource": "whatis *", "effect": "allow" },
    { "action": "shell", "resource": "apropos *", "effect": "allow" },
    { "action": "shell", "resource": "tldr *", "effect": "allow" },
    // Git (non-destructive: allow / destructive & history-rewrite: ask)
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "git rebase*", "effect": "ask" },
    { "action": "shell", "resource": "git reset*", "effect": "ask" },
    { "action": "shell", "resource": "git checkout*", "effect": "ask" },
    { "action": "shell", "resource": "git restore*", "effect": "ask" },
    { "action": "shell", "resource": "git clean*", "effect": "ask" },
    { "action": "shell", "resource": "git commit*", "effect": "ask" },
    { "action": "shell", "resource": "git merge*", "effect": "ask" },
    { "action": "shell", "resource": "git revert*", "effect": "ask" },
    { "action": "shell", "resource": "git cherry-pick*", "effect": "ask" },
    { "action": "shell", "resource": "git config*", "effect": "ask" },
    // Package manager / build / test (this repo: pnpm + nps + turbo + vitest)
    { "action": "shell", "resource": "pnpm *", "effect": "allow" },
    { "action": "shell", "resource": "nps *", "effect": "allow" },
    { "action": "shell", "resource": "vitest *", "effect": "allow" },
    { "action": "shell", "resource": "gh *", "effect": "allow" },
    // Re-gate network-fetch-and-run / value-exposing forms back to ask
    { "action": "shell", "resource": "pnpm dlx*", "effect": "ask" },
    { "action": "shell", "resource": "pnpm exec*", "effect": "ask" },
    { "action": "shell", "resource": "pnpm create*", "effect": "ask" },
    { "action": "shell", "resource": "gh auth*", "effect": "ask" },
    { "action": "shell", "resource": "gh secret*", "effect": "ask" },
    // Note: npx / bunx / node / bash -c stay ask by default
    // Version checks
    { "action": "shell", "resource": "node --version *", "effect": "allow" },
    { "action": "shell", "resource": "node -v *", "effect": "allow" },
    // Docker (read-only; repo has Dockerfile + docker-compose.web.yml)
    { "action": "shell", "resource": "docker --version *", "effect": "allow" },
    { "action": "shell", "resource": "docker ps *", "effect": "allow" },
    { "action": "shell", "resource": "docker images *", "effect": "allow" },
    { "action": "shell", "resource": "docker image ls *", "effect": "allow" },
    { "action": "shell", "resource": "docker logs *", "effect": "allow" },
    { "action": "shell", "resource": "docker logs -f*", "effect": "ask" },
    { "action": "shell", "resource": "docker logs --follow*", "effect": "ask" },
    { "action": "shell", "resource": "docker inspect *", "effect": "allow" },
    { "action": "shell", "resource": "docker info *", "effect": "allow" },
    { "action": "shell", "resource": "docker compose ls *", "effect": "allow" },
    { "action": "shell", "resource": "docker compose ps *", "effect": "allow" },
    // Deny block pinned last (not overridden by allows above)
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "wget *", "effect": "deny" },
    { "action": "shell", "resource": "dd *", "effect": "deny" },
    { "action": "shell", "resource": "mkfs*", "effect": "deny" },
    { "action": "shell", "resource": "shutdown*", "effect": "deny" },
    { "action": "shell", "resource": "reboot*", "effect": "deny" },
    { "action": "shell", "resource": "halt*", "effect": "deny" },
    { "action": "shell", "resource": "diskutil erase*", "effect": "deny" },
    { "action": "shell", "resource": ":(){ :|:& }; *", "effect": "deny" },
    // Block reading .env via bash (best-effort)
    { "action": "shell", "resource": "cat *.env", "effect": "deny" },
    { "action": "shell", "resource": "head *.env", "effect": "deny" },
    { "action": "shell", "resource": "tail *.env", "effect": "deny" },
    { "action": "shell", "resource": "cat *.env.*", "effect": "deny" },
    { "action": "skill", "resource": "*", "effect": "ask" },
    { "action": "skill", "resource": "add-e2e-test", "effect": "allow" },
    { "action": "skill", "resource": "add-error-code", "effect": "allow" },
    { "action": "skill", "resource": "add-next-route", "effect": "allow" },
    { "action": "skill", "resource": "add-redux-slice", "effect": "allow" },
    { "action": "skill", "resource": "add-shared-type", "effect": "allow" },
    { "action": "skill", "resource": "add-ui-component", "effect": "allow" },
    { "action": "skill", "resource": "add-web-test", "effect": "allow" },
    { "action": "skill", "resource": "edit-middleware", "effect": "allow" },
    { "action": "skill", "resource": "fork-layer-placement", "effect": "allow" },
    { "action": "skill", "resource": "nextjs-rsc-streaming", "effect": "allow" },
    { "action": "skill", "resource": "nextjs-server-action", "effect": "allow" },
    { "action": "skill", "resource": "sync-upstream", "effect": "allow" },
  ],
}
